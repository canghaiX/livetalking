ARG BASE_IMAGE=livetalking-main:local
FROM ${BASE_IMAGE}

ARG SOURCE_REVISION=unknown
LABEL org.opencontainers.image.title="LiveTalking" \
      org.opencontainers.image.source="https://github.com/canghaiX/livetalking" \
      org.opencontainers.image.revision="${SOURCE_REVISION}"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_ENDPOINT=https://hf-mirror.com \
    OMP_NUM_THREADS=4 \
    MKL_NUM_THREADS=4

WORKDIR /opt/livetalking
COPY requirements.txt /tmp/livetalking-workspace-requirements.txt
# The local CUDA base provides the runtime dependencies; avoid changing its CUDA stack.
RUN apt-get update \
 && apt-get install -y --no-install-recommends espeak-ng \
 && rm -rf /var/lib/apt/lists/* \
 && python -c "import aiohttp, aiortc, openai"

RUN python -m pip install --no-cache-dir 'piper-tts[zh]==1.8.0'

COPY . /opt/livetalking
RUN python -c "import app; import avatars.wav2lip_avatar; import tts.edge" \
 && python -m pip freeze > /opt/livetalking/requirements.installed.txt

EXPOSE 8020
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8020/api/admin/config', timeout=4)"
ENTRYPOINT ["python", "app.py"]
CMD ["--config", "deployment/config.yaml"]
